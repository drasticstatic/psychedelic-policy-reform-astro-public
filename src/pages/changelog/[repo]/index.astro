---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Who from "../../../components/Who.astro";
import { PRIORITY, bucketBySlug, entrySlug } from "../../../data/site";

export async function getStaticPaths() {
  const entries = await getCollection("changelog");
  const repos = [...new Set(entries.map((e) => e.data.repo ?? "initiative"))];
  return repos.map((repo) => ({ params: { repo } }));
}

const { repo } = Astro.params;
const base = import.meta.env.BASE_URL;
const entries = (await getCollection("changelog"))
  .filter((e) => (e.data.repo ?? "initiative") === repo)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const priorityLabel = PRIORITY;
const repoName = bucketBySlug(repo)?.name ?? repo;
---

<Base
  title={`${repoName} — Changelog`}
  description={`What's been built for ${repoName}, in plain language.`}
  filename={`changelog/${repo}/index.astro`}
  active="changelog"
>
  <section class="content-section">
    <p class="back"><a href={`${base}/changelog`}><i class="ph ph-arrow-left"></i> All projects</a></p>
    <h1>{repoName}</h1>

    <div class="controls">
      <input type="search" id="search-input" placeholder="Search entries" aria-label="Search changelog entries" />
      <div class="priority-filters" role="group" aria-label="Filter by priority">
        <button class="filter-pill active" data-priority="all" aria-pressed="true">All</button>
        <button class="filter-pill" data-priority="P1-high" aria-pressed="false">High</button>
        <button class="filter-pill" data-priority="P2-medium" aria-pressed="false">Medium</button>
        <button class="filter-pill" data-priority="P3-low" aria-pressed="false">Low</button>
      </div>
    </div>

    <ul class="changelog-list" id="changelog-list">
      {
        entries.map((entry) => (
          <li
            class="changelog-item"
            data-priority={entry.data.priority}
            data-search={`${entry.data.title} ${entry.data.who ?? ""} ${entry.body ?? ""}`.toLowerCase()}
          >
            <a href={`${base}/changelog/${repo}/${entrySlug(entry.id)}`}>
              <span class="entry-title">{entry.data.title}<span data-arr-new-tag hidden></span></span>
              <span class="entry-meta">
                <span class={`priority-badge priority-${entry.data.priority}`}>{priorityLabel[entry.data.priority]}</span>
                <span class="entry-date tabular">{entry.data.date}</span>
                {entry.data.who && <span class="entry-who"><Who who={entry.data.who} size={20} />{entry.data.who}</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="no-results" id="no-results" hidden>Nothing matches that search. Try fewer words, or pick "All".</p>
  </section>
</Base>

<script>
  const searchInput = document.getElementById("search-input") as HTMLInputElement;
  const pills = document.querySelectorAll<HTMLButtonElement>(".filter-pill");
  const items = document.querySelectorAll<HTMLLIElement>(".changelog-item");
  const noResults = document.getElementById("no-results")!;
  let activePriority = "all";

  function applyFilters() {
    const query = searchInput.value.trim().toLowerCase();
    let visible = 0;
    items.forEach((item) => {
      const show =
        (activePriority === "all" || item.dataset.priority === activePriority) &&
        (!query || (item.dataset.search ?? "").includes(query));
      item.hidden = !show;
      if (show) visible++;
    });
    noResults.hidden = visible > 0;
  }

  searchInput?.addEventListener("input", applyFilters);
  pills.forEach((pill) =>
    pill.addEventListener("click", () => {
      pills.forEach((p) => {
        p.classList.remove("active");
        p.setAttribute("aria-pressed", "false");
      });
      pill.classList.add("active");
      pill.setAttribute("aria-pressed", "true");
      activePriority = pill.dataset.priority ?? "all";
      applyFilters();
    })
  );
</script>

<style>
  .content-section {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 3rem;
  }
  .back {
    margin: 0 0 1rem;
  }
  .back a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }
  .back a:hover {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.4rem);
    line-height: 1.12;
    margin: 0 0 1.5rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  #search-input {
    flex: 1;
    min-width: 12rem;
    padding: 0.6rem 0.9rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: inherit;
    font: inherit;
    font-size: 0.95rem;
  }
  .priority-filters {
    display: flex;
    gap: 0.35rem;
  }
  .filter-pill {
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .filter-pill.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .changelog-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .changelog-list a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }
  .changelog-list a:hover .entry-title {
    color: var(--accent);
  }
  .entry-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .entry-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .priority-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.08rem 0.55rem;
    border-radius: 999px;
  }
  .priority-P1-high {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--foreground);
  }
  .priority-P2-medium {
    background: color-mix(in srgb, var(--leaf) 20%, transparent);
    color: var(--foreground);
  }
  .priority-P3-low {
    background: color-mix(in srgb, var(--muted) 15%, transparent);
    color: var(--muted);
  }
  .entry-who {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .no-results {
    color: var(--muted);
    margin-top: 1.25rem;
  }
</style>
