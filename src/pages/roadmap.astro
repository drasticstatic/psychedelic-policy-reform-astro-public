---
// /roadmap: the repository's ROADMAP.md, as a page (kit 1.2).
import Base from "../layouts/Base.astro";
import RepoDoc from "../components/RepoDoc.astro";
import { NAME } from "../data/site";
import { pageCardUrl } from "../og/pages";
---

<Base title={`Roadmap — ${NAME} AstroLog`} description={`Where ${NAME} is headed: an evidence library, a Pennsylvania lane, partner organizations, and what this work can mean for each community it serves.`} active="roadmap" ogImage={pageCardUrl("roadmap")} ogAlt={`${NAME}'s roadmap: what comes next, beside the keystone arch.`}>
  <RepoDoc doc="roadmap" />
</Base>
